rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.uid == userId &&
        data.email is string && data.email.size() <= 256;
    }

    function isValidDiary(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() <= 300 &&
        data.content is string && data.content.size() <= 10000 &&
        data.date is string && data.date.size() <= 30 &&
        data.mood is string && data.mood.size() <= 50 &&
        data.stressLevel is number && data.stressLevel >= 1 && data.stressLevel <= 10;
    }

    function isValidAward(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.awardTitle is string && data.awardTitle.size() <= 200 &&
        data.reason is string && data.reason.size() <= 2000;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /diaries/{diaryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(diaryId) && isValidDiary(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(diaryId);
      }

      match /awards/{awardId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(awardId) && isValidAward(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(awardId);
      }
    }
  }
}
