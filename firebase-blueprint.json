{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "Graduate student emotion diary entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 30 },
        "time": { "type": "string", "maxLength": 20 },
        "mood": { "type": "string", "maxLength": 50 },
        "stressLevel": { "type": "number" },
        "labHours": { "type": "number" },
        "tags": { "type": "array" },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 10000 },
        "aiFeedback": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "date", "mood", "stressLevel", "title", "content"]
    },
    "AwardEntry": {
      "title": "AwardEntry",
      "description": "Daily achievement award certificate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "awardTitle": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 2000 },
        "cheerQuote": { "type": "string", "maxLength": 500 },
        "recommendedReward": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "awardTitle", "reason"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/users/{userId}/diaries/{diaryId}": {
      "schema": { "$ref": "#/entities/DiaryEntry" },
      "description": "Collection of user emotion diary entries"
    },
    "/users/{userId}/awards/{awardId}": {
      "schema": { "$ref": "#/entities/AwardEntry" },
      "description": "Collection of user achievement awards"
    }
  }
}
